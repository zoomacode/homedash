package templates

import "github.com/zoomacode/homedash/internal/state"

templ News(items []state.NewsItem) {
	<section id="news"
		hx-get="/fragment/news"
		hx-trigger="sse:news"
		hx-swap="outerHTML">
		<h2>News</h2>
		<ul>
			for _, n := range items {
				<li>
					<a href={ templ.URL(n.Link) } target="_blank" rel="noopener">{ n.Title }</a>
					<span class="feed">{ n.Feed }</span>
				</li>
			}
		</ul>
	</section>
}
