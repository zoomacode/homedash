package templates

templ AuthBanner(visible bool) {
	if visible {
		<div class="banner banner-error">iCloud authentication failed — rotate the app password.</div>
	}
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width,initial-scale=1"/>
		<title>{ title }</title>
		<link rel="stylesheet" href="/static/styles.css"/>
		@templ.Raw(`<script>
(function(){try{
  var s=localStorage.getItem("theme");
  if(s!=="light"&&s!=="dark")
    s=window.matchMedia("(prefers-color-scheme: light)").matches?"light":"dark";
  document.documentElement.setAttribute("data-theme",s);
}catch(_){document.documentElement.setAttribute("data-theme","dark");}})();
</script>`)
		<script src="/static/htmx.min.js" defer></script>
		<script src="/static/htmx-sse.js" defer></script>
		<script src="/static/theme.js" defer></script>
		<script src="/static/reminders.js" defer></script>
	</head>
	<body hx-ext="sse" sse-connect="/events">
		<button id="theme-toggle" type="button" aria-label="Toggle theme">☀</button>
		<main>
			{ children... }
		</main>
	</body>
	</html>
}
