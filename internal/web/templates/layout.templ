package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width,initial-scale=1"/>
		<title>{ title }</title>
		<link rel="stylesheet" href="/static/styles.css"/>
		<script src="/static/htmx.min.js" defer></script>
	</head>
	<body>
		<main>
			{ children... }
		</main>
	</body>
	</html>
}
