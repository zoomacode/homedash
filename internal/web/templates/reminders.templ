package templates

import (
	"fmt"
	"sort"
	"time"
	"github.com/zoomacode/homedash/internal/state"
)

templ ReminderItem(r state.Reminder) {
	<li id={ "rem-" + r.UID } class={ "reminder", templ.KV("done", r.Done), templ.KV("overdue", isOverdue(r)) }>
		<form
			hx-post={ "/reminders/" + r.UID + "/toggle" }
			hx-swap="outerHTML"
			hx-target={ "#rem-" + r.UID }>
			<label>
				<input type="checkbox" name="done" if r.Done { checked }/>
				<div class="body">
					<div class="title">{ r.Title }</div>
					if !r.Due.IsZero() || r.Notes != "" {
						<div class="meta">
							if !r.Due.IsZero() {
								<span class={ "due", templ.KV("due-overdue", isOverdue(r)), templ.KV("due-today", isDueToday(r)) }>{ formatDue(r.Due) }</span>
							}
							if r.Notes != "" {
								<span class="notes">{ r.Notes }</span>
							}
						</div>
					}
				</div>
			</label>
		</form>
	</li>
}

// reminderGrace is how long a ticked reminder stays visible (struck
// out) before the dashboard hides it.
const reminderGrace = 5 * time.Minute

templ Reminders(items []state.Reminder) {
	{{ visible := sortReminders(filterStaleDone(items)) }}
	<section id="reminders"
		hx-get="/fragment/reminders"
		hx-trigger={ "sse:reminders" + refreshAfterTrigger(items) }
		hx-swap="outerHTML">
		<h2>Reminders</h2>
		if len(visible) == 0 {
			<p class="empty">all caught up</p>
		} else {
			<ul>
				for _, r := range visible {
					@ReminderItem(r)
				}
			</ul>
		}
	</section>
}

// filterStaleDone drops reminders that have been Done for longer than
// reminderGrace. The handler stamps Reminder.Completed at click time so
// this works even before the next Google Tasks poll catches up.
func filterStaleDone(rs []state.Reminder) []state.Reminder {
	out := make([]state.Reminder, 0, len(rs))
	for _, r := range rs {
		if r.Done && !r.Completed.IsZero() && time.Since(r.Completed) > reminderGrace {
			continue
		}
		out = append(out, r)
	}
	return out
}

// refreshAfterTrigger appends a "load delay:" htmx trigger so that
// when the soonest reminder is about to age out of the grace window
// the panel re-renders on its own (otherwise it'd stay until the next
// SSE notification, which only fires on Google poll changes).
func refreshAfterTrigger(rs []state.Reminder) string {
	var soonest time.Duration
	for _, r := range rs {
		if !r.Done || r.Completed.IsZero() {
			continue
		}
		remain := reminderGrace - time.Since(r.Completed)
		if remain <= 0 {
			continue
		}
		if soonest == 0 || remain < soonest {
			soonest = remain
		}
	}
	if soonest == 0 {
		return ""
	}
	// Add a small buffer so the timer fires after the threshold passes.
	soonest += 2 * time.Second
	return fmt.Sprintf(", load delay:%dms", soonest.Milliseconds())
}

// sortReminders puts overdue first, then due today, then by ascending
// due date, then dateless reminders at the bottom. Within each bucket,
// not-done items come before done items.
func sortReminders(rs []state.Reminder) []state.Reminder {
	out := append([]state.Reminder{}, rs...)
	now := startOfToday()
	rank := func(r state.Reminder) int {
		if r.Done {
			return 4
		}
		if r.Due.IsZero() {
			return 3
		}
		if r.Due.Before(now) {
			return 0
		}
		if isDueToday(r) {
			return 1
		}
		return 2
	}
	sort.SliceStable(out, func(i, j int) bool {
		ri, rj := rank(out[i]), rank(out[j])
		if ri != rj {
			return ri < rj
		}
		if !out[i].Due.IsZero() && !out[j].Due.IsZero() {
			return out[i].Due.Before(out[j].Due)
		}
		return false
	})
	return out
}

func startOfToday() time.Time {
	t := time.Now()
	return time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, t.Location())
}

func isOverdue(r state.Reminder) bool {
	if r.Done || r.Due.IsZero() {
		return false
	}
	return r.Due.Before(startOfToday())
}

func isDueToday(r state.Reminder) bool {
	if r.Due.IsZero() {
		return false
	}
	t := startOfToday()
	return !r.Due.Before(t) && r.Due.Before(t.AddDate(0, 0, 1))
}

func formatDue(due time.Time) string {
	today := startOfToday()
	tomorrow := today.AddDate(0, 0, 1)
	dayAfter := tomorrow.AddDate(0, 0, 1)
	switch {
	case due.Before(today):
		return "Overdue · " + due.Format("Mon 2 Jan")
	case !due.Before(today) && due.Before(tomorrow):
		return "Today"
	case !due.Before(tomorrow) && due.Before(dayAfter):
		return "Tomorrow"
	default:
		return due.Format("Mon 2 Jan")
	}
}
