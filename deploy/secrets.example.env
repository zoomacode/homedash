# iCloud credentials for CalDAV (events, reminders) and photos polling.
# Use an Apple ID app-specific password, NOT your main Apple ID password.
# Generate one at: https://appleid.apple.com/account/manage → App-Specific Passwords
ICLOUD_USER=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# MQTT broker credentials. Leave both empty for an unauthenticated broker.
MQTT_USERNAME=mosquitto
MQTT_PASSWORD=change-me

# Google OAuth client (Desktop application type) for Google Tasks + Photos.
# Create at https://console.cloud.google.com/ → APIs & Services → Credentials.
# Leave both empty to skip Google integrations.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Todoist API token from https://todoist.com/app/settings/integrations/developer
# Leave empty to skip Todoist integration.
TODOIST_TOKEN=
